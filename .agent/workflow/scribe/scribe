#!/usr/bin/env python3
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path


def _delegate(command: list[str], *, platform_name: str = os.name) -> int:
    if platform_name == "nt":
        return subprocess.run(command, check=False, shell=False).returncode
    os.execv(sys.executable, command)
    return 127


def main() -> int:
    target = Path(__file__).resolve().parent / "sel" / "scribe"
    command = [sys.executable, str(target), *sys.argv[1:]]
    return _delegate(command)


if __name__ == "__main__":
    raise SystemExit(main())
